      "query": {
        "id": "c3d4e5f6-a7b8-4012-cdef-012345678901",
        "queryType": "promql",
        "promql": [
          {
            "name": "A",
            "query": "sum by (machine, app, region) (label_replace(rate(fly_instance_cpu{mode!=\"idle\"}[5m]), \"machine\", \"$1\", \"exported_instance\", \"(.*)\")) / sum by (machine, app, region) (label_replace(rate(fly_instance_cpu[5m]), \"machine\", \"$1\", \"exported_instance\", \"(.*)\")) * 100",
            "legend": "CPU %",
            "disabled": false
          },
          {
            "name": "B",
            "query": "(1 - avg by (machine, app, region) (label_replace(fly_instance_memory_mem_available, \"machine\", \"$1\", \"exported_instance\", \"(.*)\")) / avg by (machine, app, region) (label_replace(fly_instance_memory_mem_total, \"machine\", \"$1\", \"exported_instance\", \"(.*)\")))*100",
            "legend": "Memory %",
            "disabled": false
          },
          {
            "name": "C",
            "query": "sum by (machine, app, region) (label_replace(rate(fly_instance_cpu{mode=\"iowait\"}[5m]), \"machine\", \"$1\", \"exported_instance\", \"(.*)\")) / sum by (machine, app, region) (label_replace(rate(fly_instance_cpu[5m]), \"machine\", \"$1\", \"exported_instance\", \"(.*)\")) * 100",
            "legend": "IO Wait %",
            "disabled": false
          },
          {
            "name": "D",
            "query": "avg by (machine, app, region) (label_replace(fly_instance_load_average{minutes=\"1\"}, \"machine\", \"$1\", \"exported_instance\", \"(.*)\"))",
            "legend": "Load Avg (1m)",
            "disabled": false
          }
        ],
