<?xml version="1.0"?>
<clickhouse>
    <!-- See also the files in users.d directory where the settings can be overridden. -->

    <profiles>
        <!-- Default profile — used by the OTel collector (writes) and the
             schema migrator (DDL).  No execution-time cap because INSERT
             and DDL operations can legitimately run for minutes. -->
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <load_balancing>random</load_balancing>
        </default>

        <!-- Queries profile — used by the SigNoz UI and alert-evaluation
             engine (reads only).  Hard caps prevent a runaway SELECT from
             saturating ClickHouse and starving Keeper heartbeat threads,
             which was the root cause of the May 2026 session-expiry incident
             (see diagnoses/2026-05-21-zookeeper-fsync-data-loss.md). -->
        <queries>
            <max_memory_usage>5000000000</max_memory_usage>
            <load_balancing>random</load_balancing>
            <!-- Fail a SELECT after 30 s so it doesn't hold threads indefinitely. -->
            <max_execution_time>30</max_execution_time>
            <!-- Limit read parallelism so write threads and Keeper always
                 have CPU available. -->
            <max_threads>4</max_threads>
        </queries>

        <!-- Profile that allows only read queries. -->
        <readonly>
            <readonly>1</readonly>
        </readonly>
    </profiles>

    <users>
        <!-- default — OTel collector writes + schema migrator DDL.
             Both connect via the host network (tcp://127.0.0.1:9000). -->
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>

        <!-- signoz — SigNoz query service and alert-evaluation engine.
             Connects via the Docker bridge network (tcp://signoz:@clickhouse:9000).
             Uses the `queries` profile so that heavy UI queries or alert-eval
             timeouts never monopolise ClickHouse CPU. -->
        <signoz>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>queries</profile>
            <quota>default</quota>
        </signoz>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
