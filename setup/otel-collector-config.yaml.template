connectors:
  signozmeter:
    metrics_flush_interval: 1h
    dimensions:
      - name: service.name
      - name: deployment.environment
      - name: host.name
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318
  httplogreceiver/json:
    endpoint: 0.0.0.0:8082
    source: json
  prometheus:
    config:
      global:
        scrape_interval: 60s
      scrape_configs:
# __FLY_ORG_SCRAPE_CONFIGS__
        - job_name: otel-collector
          static_configs:
            - targets:
                - localhost:8888
              labels:
                job_name: otel-collector

        # ClickHouse self-metrics: insert rate, active connections, merge queue,
        # memory usage. Gives early warning of ClickHouse degradation before a
        # full outage. Port 9363 is mapped to 127.0.0.1:9363 in docker-compose.
        - job_name: clickhouse
          metrics_path: /metrics
          static_configs:
            - targets:
                - localhost:9363
              labels:
                service_name: signoz-clickhouse
processors:
  batch:
    send_batch_size: 5000       # halved — smaller INSERTs create fewer parts under load
    send_batch_max_size: 6000
    timeout: 10s
  batch/meter:
    send_batch_max_size: 12500
    send_batch_size: 10000
    timeout: 1s
  resourcedetection:
    # Using OTEL_RESOURCE_ATTRIBUTES envvar, env detector adds custom labels.
    detectors: [env, system]
    timeout: 2s
  # Promote exported_instance/app/region from data-point labels → resource attributes.
  # The Prometheus receiver renames the Fly.io `instance` label to `exported_instance`
  # because `instance` is a reserved Prometheus meta-label (the scrape target address).
  groupbyattrs/fly-promote-to-resource:
    keys: [exported_instance, app, region]

  # Set host.name = exported_instance (the Fly.io VM machine ID).
  resource/fly-set-hostname:
    attributes:
      - action: upsert
        key: host.name
        from_attribute: exported_instance

  # Copy host.name and grouping labels from resource attributes → data-point attributes
  # so the SigNoz Query Builder can discover and group by them.
  transform/fly-copy-hostname-to-dp:
    error_mode: ignore
    metric_statements:
      - context: datapoint
        statements:
          - set(attributes["host.name"], resource.attributes["host.name"])
          - set(attributes["exported_instance"], resource.attributes["exported_instance"])
          - set(attributes["app"], resource.attributes["app"])
          - set(attributes["region"], resource.attributes["region"])

  signozspanmetrics/delta:
    metrics_exporter: signozclickhousemetrics
    metrics_flush_interval: 60s
    latency_histogram_buckets:
      [
        100us,
        1ms,
        2ms,
        6ms,
        10ms,
        50ms,
        100ms,
        250ms,
        500ms,
        1000ms,
        1400ms,
        2000ms,
        5s,
        10s,
        20s,
        40s,
        60s,
      ]
    dimensions_cache_size: 100000
    aggregation_temporality: AGGREGATION_TEMPORALITY_DELTA
    enable_exp_histogram: true
    dimensions:
      - name: service.namespace
        default: default
      - name: deployment.environment
        default: default
      # This is added to ensure the uniqueness of the timeseries
      # Otherwise, identical timeseries produced by multiple replicas of
      # collectors result in incorrect APM metrics
      - name: signoz.collector.id
      - name: service.version
      - name: browser.platform
      - name: browser.mobile
      - name: k8s.cluster.name
      - name: k8s.node.name
      - name: k8s.namespace.name
      - name: host.name
      - name: host.type
      - name: container.name
extensions:
  health_check:
    endpoint: 0.0.0.0:13133
  pprof:
    endpoint: 0.0.0.0:1777
# Force IPv4 for all ClickHouse connections.
# On this host `localhost` resolves to the IPv6 address [fdf::1] which causes
# i/o timeouts because ClickHouse only listens on 127.0.0.1 (IPv4).
exporters:
  clickhousetraces:
    datasource: tcp://127.0.0.1:9000/signoz_traces
    low_cardinal_exception_grouping: ${env:LOW_CARDINAL_EXCEPTION_GROUPING}
    use_new_schema: true
    sending_queue:
      num_consumers: 2
  signozclickhousemetrics:
    dsn: tcp://127.0.0.1:9000/signoz_metrics
    sending_queue:
      num_consumers: 2
  clickhouselogsexporter:
    dsn: tcp://127.0.0.1:9000/signoz_logs
    timeout: 10s
    use_new_schema: true
    sending_queue:
      num_consumers: 2
  signozclickhousemeter:
    dsn: tcp://127.0.0.1:9000/signoz_meter
    timeout: 45s
    sending_queue:
      enabled: false  # meter exporter manages its own queue
  metadataexporter:
    cache:
      provider: in_memory
    dsn: tcp://127.0.0.1:9000/signoz_metadata
    enabled: true
    timeout: 45s
service:
  telemetry:
    logs:
      encoding: json
  extensions:
    - health_check
    - pprof
  pipelines:
    traces:
      receivers: [otlp]
      processors: [signozspanmetrics/delta, batch]
      exporters: [clickhousetraces, metadataexporter, signozmeter]
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [signozclickhousemetrics, metadataexporter, signozmeter]
    # Raw Fly.io metrics plus host.name = exported_instance on every fly_instance_* series.
    metrics/prometheus:
      receivers: [prometheus]
      processors:
        - groupbyattrs/fly-promote-to-resource
        - resource/fly-set-hostname
        - transform/fly-copy-hostname-to-dp
        - batch
      exporters: [signozclickhousemetrics, metadataexporter, signozmeter]
    logs:
      receivers: [otlp, httplogreceiver/json]
      processors: [batch]
      exporters: [clickhouselogsexporter, metadataexporter, signozmeter]
    metrics/meter:
      receivers: [signozmeter]
      processors: [batch/meter]
      exporters: [signozclickhousemeter]
