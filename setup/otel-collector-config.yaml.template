connectors:
  signozmeter:
    metrics_flush_interval: 1h
    dimensions:
      - name: service.name
      - name: deployment.environment
      - name: host.name
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318
  httplogreceiver/json:
    endpoint: 0.0.0.0:8082
    source: json
  prometheus:
    config:
      global:
        scrape_interval: 60s
      scrape_configs:
# __FLY_ORG_SCRAPE_CONFIGS__
        - job_name: otel-collector
          static_configs:
            - targets:
                - localhost:8888
              labels:
                job_name: otel-collector

        # ClickHouse self-metrics: insert rate, active connections, merge queue,
        # memory usage. Gives early warning of ClickHouse degradation before a
        # full outage. Port 9363 is mapped to 127.0.0.1:9363 in docker-compose.
        - job_name: clickhouse
          metrics_path: /metrics
          static_configs:
            - targets:
                - localhost:9363
              labels:
                service_name: signoz-clickhouse
processors:
  batch:
    send_batch_size: 5000       # halved — smaller INSERTs create fewer parts under load
    send_batch_max_size: 6000
    timeout: 10s
  batch/meter:
    send_batch_max_size: 12500
    send_batch_size: 10000
    timeout: 1s
  resourcedetection:
    # Using OTEL_RESOURCE_ATTRIBUTES envvar, env detector adds custom labels.
    detectors: [env, system]
    timeout: 2s
  # Keeps only the two memory metrics needed for utilization computation
  # so the fly-memory-route pipeline sends a minimal payload to the sidecar.
  filter/fly-memory-for-sidecar:
    error_mode: ignore
    metrics:
      include:
        match_type: regexp
        metric_names: ["^fly_instance_memory_(active|mem_total)$"]

  # Promote exported_instance/app/region from data-point labels → resource attributes.
  # The Prometheus receiver renames the Fly.io `instance` label to `exported_instance`
  # because `instance` is a reserved Prometheus meta-label (the scrape target address).
  groupbyattrs/fly-promote-to-resource:
    keys: [exported_instance, app, region]

  # Set host.name = exported_instance (the Fly.io VM machine ID).
  # Used by fly-memory-route and fly-cpu-utilization pipelines.
  resource/fly-set-hostname:
    attributes:
      - action: upsert
        key: host.name
        from_attribute: exported_instance

  # Copy host.name and grouping labels from resource attributes → data-point attributes
  # so the SigNoz Query Builder can discover and group by them.
  transform/fly-copy-hostname-to-dp:
    error_mode: ignore
    metric_statements:
      - context: datapoint
        statements:
          - set(attributes["host.name"], resource.attributes["host.name"])
          - set(attributes["exported_instance"], resource.attributes["exported_instance"])
          - set(attributes["app"], resource.attributes["app"])
          - set(attributes["region"], resource.attributes["region"])

  # ── Fly.io CPU & IOWait Utilisation Gauges ───────────────────────────────
  # fly_instance_cpu is a monotonic counter (centiseconds per cpu_id × mode).
  # The SigNoz Query Builder has no rate() time aggregation, so we pre-compute
  # per-instance utilisation as 0-100 Gauge metrics at ingest time.
  #
  # Pipeline:
  #   cumulativetodelta → aggregate across cpu_id → subtract idle → divide
  #   → scale ×100 → stored as fly_instance_cpu_utilization (0-100 Gauge)
  #                      and fly_instance_iowait_utilization (0-100 Gauge)

  filter/fly-cpu-only:
    error_mode: ignore
    metrics:
      include:
        match_type: regexp
        metric_names: ["^fly_instance_cpu(|_baseline)$"]

  # Convert cumulative counter → per-scrape-interval delta.
  # Note: max_stale and subtract are not supported in this collector build.
  cumulativetodelta/fly-cpu:
    include:
      match_type: regexp
      metrics:
        - "^fly_instance_cpu(|_baseline)$"

  # Aggregate the per-(cpu_id, mode) delta series into per-(instance, app, region) sums.
  # NOTE: aggregate_labels sums across modes but not cpu_ids in this build.
  # fly_instance_cpu_utilization therefore represents user-mode CPU load across all
  # cores: values >100% on multi-CPU machines mean >1 full CPU equivalent in use.
  metricstransform/fly-cpu-deltas:
    transforms:
      - include: fly_instance_cpu
        match_type: strict
        action: insert
        new_name: fly_instance_cpu_delta_total
        operations:
          - action: aggregate_labels
            label_set: [exported_instance, app, region]
            aggregation_type: sum
      - include: fly_instance_cpu
        match_type: strict
        experimental_match_labels: {mode: "user"}
        action: insert
        new_name: fly_instance_cpu_delta_user
        operations:
          - action: aggregate_labels
            label_set: [exported_instance, app, region]
            aggregation_type: sum
      - include: fly_instance_cpu
        match_type: strict
        experimental_match_labels: {mode: "iowait"}
        action: insert
        new_name: fly_instance_cpu_delta_iowait
        operations:
          - action: aggregate_labels
            label_set: [exported_instance, app, region]
            aggregation_type: sum

  metricsgeneration/fly-cpu-utilization:
    rules:
      # user / total * 100 = user-mode CPU load across all cores.
      # Values >100 on multi-CPU machines indicate >1 full CPU equivalent in use.
      # metricsgeneration subtract is not supported in this collector build.
      - name: fly_instance_cpu_utilization
        unit: "1"
        type: calculate
        metric1: fly_instance_cpu_delta_user
        metric2: fly_instance_cpu_delta_total
        operation: divide
      - name: fly_instance_iowait_utilization
        unit: "1"
        type: calculate
        metric1: fly_instance_cpu_delta_iowait
        metric2: fly_instance_cpu_delta_total
        operation: divide

  metricstransform/fly-cpu-scale:
    transforms:
      - include: fly_instance_cpu_utilization
        match_type: strict
        action: update
        operations:
          - action: experimental_scale_value
            experimental_scale: 100
      - include: fly_instance_iowait_utilization
        match_type: strict
        action: update
        operations:
          - action: experimental_scale_value
            experimental_scale: 100

  filter/fly-cpu-util-only:
    error_mode: ignore
    metrics:
      include:
        match_type: regexp
        metric_names: ["^fly_instance_(cpu|iowait)_utilization$"]

  # ── End Fly.io CPU & IOWait Utilisation Gauges ────────────────────────────

  signozspanmetrics/delta:
    metrics_exporter: signozclickhousemetrics
    metrics_flush_interval: 60s
    latency_histogram_buckets:
      [
        100us,
        1ms,
        2ms,
        6ms,
        10ms,
        50ms,
        100ms,
        250ms,
        500ms,
        1000ms,
        1400ms,
        2000ms,
        5s,
        10s,
        20s,
        40s,
        60s,
      ]
    dimensions_cache_size: 100000
    aggregation_temporality: AGGREGATION_TEMPORALITY_DELTA
    enable_exp_histogram: true
    dimensions:
      - name: service.namespace
        default: default
      - name: deployment.environment
        default: default
      # This is added to ensure the uniqueness of the timeseries
      # Otherwise, identical timeseries produced by multiple replicas of
      # collectors result in incorrect APM metrics
      - name: signoz.collector.id
      - name: service.version
      - name: browser.platform
      - name: browser.mobile
      - name: k8s.cluster.name
      - name: k8s.node.name
      - name: k8s.namespace.name
      - name: host.name
      - name: host.type
      - name: container.name
extensions:
  health_check:
    endpoint: 0.0.0.0:13133
  pprof:
    endpoint: 0.0.0.0:1777
# Force IPv4 for all ClickHouse connections.
# On this host `localhost` resolves to the IPv6 address [fdf::1] which causes
# i/o timeouts because ClickHouse only listens on 127.0.0.1 (IPv4).
exporters:
  clickhousetraces:
    datasource: tcp://127.0.0.1:9000/signoz_traces
    low_cardinal_exception_grouping: ${env:LOW_CARDINAL_EXCEPTION_GROUPING}
    use_new_schema: true
  signozclickhousemetrics:
    dsn: tcp://127.0.0.1:9000/signoz_metrics
  clickhouselogsexporter:
    dsn: tcp://127.0.0.1:9000/signoz_logs
    timeout: 10s
    use_new_schema: true
  # Forwards raw Fly memory metrics to the host-metrics sidecar (otelcol-contrib)
  # which computes system.memory.utilization via metricsgeneration and sends
  # it back via OTLP to port 4317.
  otlp/host-metrics-sidecar:
    endpoint: localhost:14317
    tls:
      insecure: true
    sending_queue:
      enabled: false

  signozclickhousemeter:
    dsn: tcp://127.0.0.1:9000/signoz_meter
    timeout: 45s
    sending_queue:
      enabled: false  # meter exporter manages its own queue
  metadataexporter:
    cache:
      provider: in_memory
    dsn: tcp://127.0.0.1:9000/signoz_metadata
    enabled: true
    timeout: 45s
service:
  telemetry:
    logs:
      encoding: json
  extensions:
    - health_check
    - pprof
  pipelines:
    traces:
      receivers: [otlp]
      processors: [signozspanmetrics/delta, batch]
      exporters: [clickhousetraces, metadataexporter, signozmeter]
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [signozclickhousemetrics, metadataexporter, signozmeter]
    metrics/prometheus:
      receivers: [prometheus]
      processors: [batch]
      exporters: [signozclickhousemetrics, metadataexporter, signozmeter]
    # Routes fly_instance_memory_active + fly_instance_memory_mem_total to the
    # host-metrics sidecar (otelcol-contrib) which computes the utilization ratio
    # via metricsgeneration and sends system.memory.utilization back.
    metrics/fly-memory-route:
      receivers: [prometheus]
      processors:
        - filter/fly-memory-for-sidecar
        - groupbyattrs/fly-promote-to-resource
        - resource/fly-set-hostname
        - batch
      exporters: [otlp/host-metrics-sidecar]
    # Fly.io per-instance CPU and IOWait utilisation gauges.
    # cumulativetodelta IS available in signoz-otel-collector; the only
    # constraint is that max_stale must not be set (unsupported in this build).
    metrics/fly-cpu-utilization:
      receivers: [prometheus]
      processors:
        - filter/fly-cpu-only
        - cumulativetodelta/fly-cpu
        - metricstransform/fly-cpu-deltas
        - metricsgeneration/fly-cpu-utilization
        - metricstransform/fly-cpu-scale
        - filter/fly-cpu-util-only
        - groupbyattrs/fly-promote-to-resource
        - resource/fly-set-hostname
        - transform/fly-copy-hostname-to-dp
        - batch
      exporters: [signozclickhousemetrics, metadataexporter]
    logs:
      receivers: [otlp, httplogreceiver/json]
      processors: [batch]
      exporters: [clickhouselogsexporter, metadataexporter, signozmeter]
    metrics/meter:
      receivers: [signozmeter]
      processors: [batch/meter]
      exporters: [signozclickhousemeter]
