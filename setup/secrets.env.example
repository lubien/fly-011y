# ── Auto-generated secrets (fill with random values or let install.sh generate) ──
SIGNOZ_JWT_SECRET=change-me-to-random-64-char-string
SIGNOZ_TOKENIZER_JWT_SECRET=change-me-to-random-64-char-string
INGESTION_KEY=change-me-to-random-40-char-string

# ── Fly.io ────────────────────────────────────────────────────────────────────
# Your org slug from `fly orgs list`
FLY_ORG=your-org-slug

# ── Sprite / External URL ─────────────────────────────────────────────────────
SIGNOZ_GLOBAL_EXTERNAL__URL=https://your-sprite.sprites.app

# ── Alert channel emails (optional) ──────────────────────────────────────────
SIGNOZ_ALERTMANAGER_SIGNOZ_GLOBAL_SMTP__SMARTHOST=smtp.resend.com:465
SIGNOZ_ALERTMANAGER_SIGNOZ_GLOBAL_SMTP__FROM=alerts@yourdomain.com
SIGNOZ_ALERTMANAGER_SIGNOZ_GLOBAL_SMTP__AUTH__USERNAME=resend
SIGNOZ_ALERTMANAGER_SIGNOZ_GLOBAL_SMTP__AUTH__PASSWORD=re_xxxxxxxxxxxx

# ── User invitation emails (optional) ────────────────────────────────────────
SIGNOZ_EMAILING_ENABLED=false
SIGNOZ_EMAILING_SMTP_ADDRESS=smtp.resend.com:465
SIGNOZ_EMAILING_SMTP_TLS_ENABLED=true
SIGNOZ_EMAILING_SMTP_AUTH_USERNAME=resend
SIGNOZ_EMAILING_SMTP_AUTH_PASSWORD=re_xxxxxxxxxxxx
SIGNOZ_EMAILING_SMTP_FROM=alerts@yourdomain.com
