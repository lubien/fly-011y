worker_processes 1;

events {
    worker_connections 1024;
}

http {
    # Route based on signoz-ingestion-key header:
    #   ui   -> no header present       -> SigNoz UI
    #   otlp -> valid API key           -> OTLP HTTP collector
    #   deny -> header present but wrong -> 401
    map $http_signoz_ingestion_key $otlp_auth {
        ""          ui;
        "${INGESTION_KEY}"    otlp;
        default     deny;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    server {
        listen 8080;
        client_max_body_size 32m;


        # Vector log shipper endpoint -> httplogreceiver on port 8082
        location /logs/vector {
            if ($otlp_auth != "otlp") {
                return 401;
            }
            proxy_pass          http://127.0.0.1:8082/;
            proxy_http_version  1.1;
            proxy_set_header    Host        $http_host;
            proxy_set_header    X-Real-IP   $remote_addr;
            proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header    X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_read_timeout      30;
            proxy_connect_timeout   10;
        }

        location / {
            if ($otlp_auth = "deny") {
                return 401;
            }

            set $upstream "127.0.0.1:3301";
            if ($otlp_auth = "otlp") {
                set $upstream "127.0.0.1:4318";
            }

            proxy_pass          http://$upstream;
            proxy_http_version  1.1;
            proxy_set_header    Upgrade     $http_upgrade;
            proxy_set_header    Connection  $connection_upgrade;
            proxy_set_header    Host        $http_host;
            proxy_set_header    X-Real-IP   $remote_addr;
            proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header    X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_read_timeout      86400;
            proxy_connect_timeout   10;
            proxy_buffer_size       128k;
            proxy_buffers           4 256k;
            proxy_busy_buffers_size 256k;
        }
    }
}
